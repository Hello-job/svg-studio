{
  "name": "svg-studio",
  "version": "0.1.0",
  "description": "A local-first SVG editor with a shadcn/ui interface, powered by SVG-Edit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hello-job/svg-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Hello-job/svg-studio/issues"
  },
  "homepage": "https://github.com/Hello-job/svg-studio#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm registry:build && tsc -b && vite build",
    "registry:build": "shadcn build && prettier public/r --write",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@svgedit/svgcanvas": "7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
